            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "max by (proposal_id, title) (latanda_gov_proposal_voting_end_timestamp_seconds * on(proposal_id) group_left(title) latanda_gov_proposal_active) * 1000",
          "legendFormat": "__auto",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
