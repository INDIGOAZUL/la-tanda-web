# Copy to .env and fill in:   cp example.env .env && chmod 600 .env
# .env is listed in .gitignore. Never commit it: it holds the Grafana password
# and the webhook URL.

# --- Required -------------------------------------------------------------------
# Grafana "admin" password, used on the first start only (change it later in the UI).
GRAFANA_ADMIN_PASSWORD=

# --- Alerts -----------------------------------------------------------------------
# Discord webhook URL (Server Settings -> Integrations -> Webhooks). Keep it secret:
# anyone who has it can post to the channel. Empty = alerts only in the Alertmanager UI.
ALERT_WEBHOOK_URL=

# Your validator's operator address(es), comma-separated (ltdvaloper1...).
# Set = jail and missed-block alerts only for these validators, for as long as they last.
# Empty = network-wide mode: every validator, jail alerts only for jails of the last 24 h.
WATCH_VALIDATORS=

# --- What to scrape (comma-separated host:port lists, no URLs, no spaces) -----------
# CometBFT metrics of latandad, config.toml: [instrumentation] prometheus = true
COMETBFT_TARGETS=localhost:26660
# Cosmos SDK telemetry, app.toml: [api] enable = true and [telemetry] enabled = true
COSMOS_API_TARGETS=localhost:1317
# node_exporter (system metrics). The bundled one listens on localhost:9100.
NODE_EXPORTER_TARGETS=localhost:9100

# --- Chain API used by latanda-exporter (one node is enough, it is chain state) ------
CHAIN_REST_URL=http://localhost:1317
# Optional, used for blocks produced and block time. Empty = take height from REST.
CHAIN_RPC_URL=http://localhost:26657
POLL_INTERVAL=30

# --- Storage and ports ------------------------------------------------------------
PROMETHEUS_RETENTION=30d
# Grafana listens on localhost only. Reach it with: ssh -L 3000:localhost:3000 user@server
# To open it on the network instead, set GRAFANA_LISTEN=0.0.0.0 and restrict port 3000 in your firewall.
GRAFANA_LISTEN=127.0.0.1
GRAFANA_PORT=3000
# 9090 is taken by the latandad gRPC server, hence 19090.
PROMETHEUS_PORT=19090
ALERTMANAGER_PORT=9093
NODE_EXPORTER_PORT=9100
EXPORTER_PORT=9561
